<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    
    <div class="col-6 offset-3">
        <h1>SignUp on Wanderlust</h1>
        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input
                    class="form-control"
                    type="text"
                    placeholder="Add a catchy title"
                    name="username"
                    id="username"
                    required
                />
                <div class="valid-feedback">Title looks good</div>
                <div class="invalid-feedback">Title looks bad</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">email</label>
                <input
                    class="form-control"
                    type="text"
                    placeholder="sample@gmail.com"
                    name="email"
                    id="email"
                    required
                />
                <div class="valid-feedback">email looks good</div>
                <div class="invalid-feedback">email looks bad</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">password</label>
                <input
                    class="form-control"
                    type="password"
                    placeholder="password"
                    name="password"
                    id="password"
                    required
                />
                <div class="valid-feedback">password looks good</div>
                <div class="invalid-feedback">password looks bad</div>
            </div>
            <button class="btn btn-success">SignUp</button>
        </form>
    </div>
</div>